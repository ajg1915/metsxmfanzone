{
  "rewrites": [
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Tt]witterbot|[Ll]inked[Ii]n[Bb]ot|[Ww]hats[Aa]pp|[Ss]lackbot(-LinkExpanding)?|[Tt]elegram[Bb]ot|[Dd]iscordbot|[Pp]interest(bot)?|redditbot|[Ee]mbedly|[Aa]pplebot|[Ss]kypeUriPreview|vkShare|W3C_Validator|[Gg]ooglebot|[Bb]ingbot).*"
        }
      ],
      "destination": "/api/og/blog/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
